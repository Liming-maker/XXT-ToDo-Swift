<Window x:Class="HomeworkToDo.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:HomeworkToDo.Core.Models;assembly=HomeworkToDo.Core"
        Title="学习通待办"
        Width="380" Height="700"
        MinWidth="320" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- 考试列表项模板 -->
        <DataTemplate x:Key="ExamTemplate" DataType="{x:Type models:Exam}">
            <Border Padding="8,6" Margin="0,2" CornerRadius="6" BorderBrush="#E8E8E8" BorderThickness="1"
                    PreviewMouseLeftButtonDown="ExamItem_MouseDoubleClick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Name}" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="40"
                               ToolTip="{Binding Name}"/>

                    <Border Grid.Row="0" Grid.Column="1"
                            Padding="6,2" CornerRadius="4" Opacity="0.15"
                            Background="{Binding IsOverdue, Converter={StaticResource StatusColorConverter}}">
                        <TextBlock Text="{Binding Status}" FontSize="11"
                                   Foreground="{Binding IsOverdue, Converter={StaticResource StatusColorConverter}}"/>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding CourseName}" FontSize="12"
                               Foreground="Gray" TextWrapping="Wrap" MaxHeight="32"/>

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding RemainingTimeDisplay}" FontSize="11"
                               Foreground="{Binding IsOverdue, Converter={StaticResource StatusColorConverter}}"
                               Margin="4,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 作业列表项模板 -->
        <DataTemplate x:Key="HomeworkTemplate" DataType="{x:Type models:Homework}">
            <Border Padding="8,6" Margin="0,2" CornerRadius="6" BorderBrush="#E8E8E8" BorderThickness="1"
                    PreviewMouseLeftButtonDown="HomeworkItem_MouseDoubleClick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Name}" FontWeight="SemiBold"
                               TextWrapping="Wrap" MaxHeight="40"
                               ToolTip="{Binding Name}"/>

                    <Border Grid.Row="0" Grid.Column="1"
                            Padding="6,2" CornerRadius="4" Opacity="0.15"
                            Background="{Binding IsOverdue, Converter={StaticResource StatusColorConverter}}">
                        <TextBlock Text="{Binding Status}" FontSize="11"
                                   Foreground="{Binding IsOverdue, Converter={StaticResource StatusColorConverter}}"/>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding CourseName}" FontSize="12"
                               Foreground="Gray" TextWrapping="Wrap" MaxHeight="32"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding RemainingTimeDisplay}" FontSize="11"
                               Foreground="{Binding IsOverdue, Converter={StaticResource StatusColorConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Background="Transparent">
            <Button Content="设置" Command="{Binding OpenSettingsCommand}" Margin="4"/>
            <Separator/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="4"/>
            <Separator/>
            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center" Foreground="Gray" Margin="4,0"/>
            <ProgressBar IsIndeterminate="True" Width="80" Height="14"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                         Margin="4,0"/>
        </ToolBar>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}"
                           Margin="0,4"/>

                <!-- Exams Section -->
                <TextBlock Text="考试列表" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <ItemsControl ItemsSource="{Binding Exams}"
                              ItemTemplate="{StaticResource ExamTemplate}"
                              Visibility="{Binding Exams.Count, Converter={StaticResource CountToVisibility}}"/>

                <!-- Exams Empty State -->
                <Border Padding="16" Margin="0,4" Visibility="{Binding Exams.Count, Converter={StaticResource CountToInverseVisibility}}">
                    <TextBlock Text="暂无未完成考试" Foreground="Gray" HorizontalAlignment="Center"/>
                </Border>

                <!-- Homework Section -->
                <TextBlock Text="作业列表" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <ItemsControl ItemsSource="{Binding Homeworks}"
                              ItemTemplate="{StaticResource HomeworkTemplate}"
                              Visibility="{Binding Homeworks.Count, Converter={StaticResource CountToVisibility}}"/>

                <!-- Homework Empty State -->
                <Border Padding="16" Margin="0,4"
                        Visibility="{Binding Homeworks.Count, Converter={StaticResource CountToInverseVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="暂无未完成作业" Foreground="Gray" HorizontalAlignment="Center"/>
                        <Button Content="去设置账号" Command="{Binding OpenSettingsCommand}"
                                Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
