<Window x:Class="HomeworkToDo.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HomeworkToDo.Wpf.ViewModels"
        Title="设置"
        Width="420" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Account -->
                <GroupBox Header="账号设置" Margin="0,0,0,12">
                    <StackPanel>
                        <Label Content="手机号"/>
                        <TextBox Text="{Binding Phone}" Margin="0,0,0,8"/>
                        <Label Content="密码"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,4"/>
                    </StackPanel>
                </GroupBox>

                <!-- Content Control -->
                <GroupBox Header="内容控制" Margin="0,0,0,12">
                    <Button Content="编辑显示的课程" Command="{Binding OpenCourseSelectionCommand}"
                            Margin="0,4" Height="32"/>
                </GroupBox>

                <!-- Notifications -->
                <GroupBox Header="通知提醒" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="当作业剩余下列时间时发送提醒：" FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding Thresholds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Converter={StaticResource MinuteFormat}}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Width="24" Height="24"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.RemoveThresholdCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewThreshold}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="添加" Command="{Binding AddThresholdCommand}"
                                    IsEnabled="{Binding NewThreshold, Converter={StaticResource StringNotEmpty}}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Refresh -->
                <GroupBox Header="自动刷新" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding RefreshInterval, StringFormat='刷新间隔: {0:N0} 分钟'}"/>
                        <Slider Minimum="5" Maximum="120" TickFrequency="5"
                                Value="{Binding RefreshInterval}" IsSnapToTickEnabled="True"
                                Margin="0,4"/>
                    </StackPanel>
                </GroupBox>

                <!-- Auto Start -->
                <GroupBox Header="启动选项" Margin="0,0,0,12">
                    <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart}" Margin="4"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="完成" Width="80" Height="30" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
