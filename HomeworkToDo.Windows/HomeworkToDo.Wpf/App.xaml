<Application x:Class="HomeworkToDo.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HomeworkToDo.Wpf.Converters"
             xmlns:local="clr-namespace:HomeworkToDo.Wpf"
             Startup="Application_Startup">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters from StatusColorConverter.cs -->
            <conv:StatusColorConverter x:Key="StatusColorConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>

            <!-- Converters from SettingsWindow.xaml.cs -->
            <local:MinuteFormatConverter x:Key="MinuteFormat"/>
            <local:StringNotEmptyConverter x:Key="StringNotEmpty"/>

            <!-- Count to Visibility -->
            <local:CountToVisibilityConverter x:Key="CountToVisibility"/>
            <local:CountToInverseVisibilityConverter x:Key="CountToInverseVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
